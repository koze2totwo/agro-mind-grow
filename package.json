{
    "name": "agro-mind-grow-root",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" --names \"Frontend,Backend\" --prefix-colors \"cyan,yellow\"",
        "dev:frontend": "npm run dev --prefix frontend",
        "dev:backend": "cd backend && python api.py",
        "install:all": "npm install && npm install --prefix frontend",
        "build": "npm run build --prefix frontend"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}